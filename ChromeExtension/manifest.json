{
  "manifest_version": 3,
  "name": "Trimd",
  "version": "1.0",
  "description": "Tailor your resume to the job posting in the active tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "https://www.trimdcv.com/*", "https://trimdcv.com/*"],
      "js": ["authBridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  }
}